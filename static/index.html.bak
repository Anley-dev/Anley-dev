<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hawassa Navigation & Taxi Dispatch System</title>
  <link rel="stylesheet" href="/static/lib/maplibre-gl.css" />
  <script src="/static/lib/maplibre-gl.js"></script>
  <style>
    :root {
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --bg-dark: #0f172a;
      --panel-bg: #1e293b;
      --card-bg: #334155;
      --border: #475569;
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --accent-green: #10b981;
      --accent-amber: #f59e0b;
      --accent-red: #ef4444;
      --accent-purple: #8b5cf6;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }

    body {
      background-color: var(--bg-dark);
      color: var(--text);
      display: flex;
      height: 100vh;
      overflow: hidden;
    }

    /* Left Control Sidebar */
    .sidebar {
      width: 450px;
      min-width: 380px;
      background: var(--panel-bg);
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      z-index: 1000;
      box-shadow: 4px 0 20px rgba(0,0,0,0.3);
    }

    .header {
      padding: 14px 18px;
      border-bottom: 1px solid var(--border);
      background: rgba(15, 23, 42, 0.7);
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .header-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .header-title {
      font-size: 1.1rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .agent-pill {
      font-size: 0.75rem;
      padding: 4px 10px;
      border-radius: 20px;
      background: #334155;
      display: flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      border: 1px solid var(--border);
    }
    .agent-pill:hover { background: #475569; }

    .status-bar {
      display: flex;
      gap: 12px;
      font-size: 0.78rem;
    }

    .status-tag {
      display: flex;
      align-items: center;
      gap: 5px;
      color: var(--text-muted);
    }

    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent-green);
    }
    .dot.offline { background: var(--accent-amber); }

    .content-scroll {
      flex: 1;
      overflow-y: auto;
      padding: 16px 18px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .section-title {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      font-weight: 700;
      margin-bottom: 4px;
    }

    .input-group {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .input-label {
      font-size: 0.82rem;
      font-weight: 600;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .label-badge {
      font-size: 0.7rem;
      padding: 2px 6px;
      border-radius: 4px;
      background: var(--card-bg);
      color: var(--text-muted);
    }

    select, input {
      width: 100%;
      padding: 9px 12px;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--text);
      font-size: 0.88rem;
      outline: none;
      transition: border 0.15s;
    }

    select:focus, input:focus {
      border-color: var(--primary);
    }

    .row-inputs {
      display: flex;
      gap: 8px;
    }

    .btn-small {
      padding: 8px 12px;
      font-size: 0.8rem;
      background: #475569;
      border: none;
      border-radius: 6px;
      color: var(--text);
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.15s;
    }
    .btn-small:hover { background: #64748b; }
    .btn-small.active { background: var(--accent-green); color: #000; font-weight: 700; }

    .mode-selector {
      display: flex;
      gap: 6px;
      background: var(--card-bg);
      padding: 4px;
      border-radius: 8px;
    }

    .mode-tab {
      flex: 1;
      padding: 8px 6px;
      border-radius: 6px;
      border: none;
      background: transparent;
      color: var(--text-muted);
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      text-align: center;
      transition: all 0.2s;
    }

    .mode-tab.active {
      background: var(--primary);
      color: #fff;
    }

    .btn-action {
      padding: 11px;
      border-radius: 8px;
      border: none;
      background: var(--primary);
      color: #fff;
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
      transition: all 0.2s;
    }

    .btn-action:hover {
      background: var(--primary-hover);
      transform: translateY(-1px);
    }

    .btn-secondary {
      background: #334155;
      box-shadow: none;
    }
    .btn-secondary:hover { background: #475569; }

    /* Results card */
    .result-box {
      background: var(--card-bg);
      border-radius: 8px;
      border: 1px solid var(--border);
      padding: 14px;
      display: none;
      flex-direction: column;
      gap: 12px;
    }

    .result-box.visible { display: flex; }

    .result-title {
      font-size: 0.92rem;
      font-weight: 700;
      color: var(--accent-amber);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .agent-script {
      background: rgba(15, 23, 42, 0.6);
      border-left: 3px solid var(--accent-green);
      padding: 10px 12px;
      border-radius: 4px;
      font-size: 0.84rem;
      line-height: 1.4;
      color: #e2e8f0;
    }

    .stat-pills {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }

    .stat-pill {
      background: rgba(255,255,255,0.07);
      padding: 5px 8px;
      border-radius: 6px;
      font-size: 0.78rem;
    }
    .stat-pill strong { color: #38bdf8; }

    .maneuvers-list {
      max-height: 140px;
      overflow-y: auto;
      font-size: 0.8rem;
      display: flex;
      flex-direction: column;
      gap: 5px;
      padding-right: 4px;
    }

    .maneuver-item {
      display: flex;
      align-items: flex-start;
      gap: 6px;
      color: #cbd5e1;
    }

    /* History table */
    .history-card {
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 8px 10px;
      font-size: 0.8rem;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    /* Map container */
    #map {
      flex: 1;
      height: 100vh;
      background: #0f172a;
    }

    /* MapLibre overrides */
    .maplibregl-popup-content {
      background: #1e293b;
      color: #f8fafc;
      border: 1px solid #475569;
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 13px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.5);
    }
    .maplibregl-popup-tip { border-top-color: #1e293b; border-bottom-color: #1e293b; }
    .maplibregl-popup-close-button { color: #94a3b8; font-size: 16px; padding: 4px 8px; }
    .maplibregl-popup-close-button:hover { color: #fff; background: rgba(255,255,255,0.1); border-radius: 4px; }
    .maplibregl-ctrl-attrib { font-size: 10px !important; }
    .maplibregl-ctrl button { background-color: #1e293b !important; border-color: #475569 !important; }
    .maplibregl-ctrl button .maplibregl-ctrl-icon { filter: invert(0.8); }

    /* Map overlays */
    .map-helper {
      position: absolute;
      top: 16px;
      right: 16px;
      z-index: 1000;
      background: rgba(15, 23, 42, 0.9);
      backdrop-filter: blur(8px);
      padding: 8px 12px;
      border-radius: 8px;
      border: 1px solid var(--border);
      font-size: 0.8rem;
      display: flex;
      flex-direction: column;
      gap: 8px;
      max-width: 520px;
    }

    .poi-filter-bar {
      display: flex;
      gap: 5px;
      flex-wrap: wrap;
    }

    .poi-chip {
      padding: 3px 8px;
      border-radius: 12px;
      font-size: 11px;
      background: #334155;
      border: 1px solid var(--border);
      color: #94a3b8;
      cursor: pointer;
      user-select: none;
      transition: all 0.15s;
    }
    .poi-chip.active {
      background: var(--primary);
      color: #fff;
      border-color: #60a5fa;
      font-weight: 600;
    }

    .poi-tooltip {
      background: rgba(15, 23, 42, 0.92) !important;
      border: 1px solid #475569 !important;
      color: #f8fafc !important;
      font-size: 11px !important;
      font-weight: 600 !important;
      border-radius: 4px !important;
      padding: 2px 6px !important;
      box-shadow: 0 2px 6px rgba(0,0,0,0.5) !important;
    }

    .legend-row {
      display: flex;
      gap: 12px;
      align-items: center;
      font-size: 0.75rem;
      color: var(--text-muted);
      border-top: 1px solid rgba(255,255,255,0.1);
      padding-top: 6px;
    }

    .legend-item { display: flex; align-items: center; gap: 6px; }
    .legend-icon { width: 12px; height: 12px; border-radius: 50%; }
    .legend-caller { background: #10b981; }
    .legend-dest { background: #ef4444; }
    .legend-taxi { background: #3b82f6; }
    .legend-poi { background: #ea580c; }

    /* Modal */
    .modal-backdrop {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.7);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 2000;
    }
    .modal-box {
      background: var(--panel-bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      width: 360px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
  </style>
</head>
<body>

  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="header">
      <div class="header-top">
        <div class="header-title">
          🚖 Hawassa Dispatch
        </div>
        <div style="display: flex; gap: 6px; align-items: center;">
          <button class="btn-small" style="background: #10b981; color: #fff; font-weight: 600; padding: 4px 8px; font-size: 0.72rem;" onclick="toggleAddPlaceModal(true)">➕ Add Station</button>
          <div class="agent-pill" id="agent-btn" onclick="toggleAuthModal()">
            <span id="agent-status-dot" class="dot offline"></span>
            <span id="agent-label">Agent Login</span>
          </div>
        </div>
      </div>
      <div class="status-bar">
        <span class="status-tag"><span class="dot" id="db-dot"></span> <span id="db-status">Places DB</span></span>
        <span class="status-tag"><span class="dot" id="valhalla-dot"></span> <span id="valhalla-status">Routing Engine</span></span>
        <span class="status-tag"><span class="dot" id="map-dot"></span> <span id="map-status">Offline Map</span></span>
      </div>
    </div>

    <div class="content-scroll">
      <!-- Mode selection -->
      <div class="mode-selector">
        <button class="mode-tab active" id="tab-nearest" onclick="setAppMode('nearest')">📍 Nearest</button>
        <button class="mode-tab" id="tab-route" onclick="setAppMode('route')">🗺️ Route</button>
        <button class="mode-tab" id="tab-ai" onclick="setAppMode('ai')">🤖 AI Assistant</button>
        <button class="mode-tab" id="tab-history" onclick="setAppMode('history')">📋 Calls (<span id="total-calls-badge">0</span>)</button>
      </div>

      <!-- AI Container -->
      <div id="ai-container" style="display: none; flex-direction: column; gap: 10px;">
        <div class="input-label">
          <span>Caller Inquiry (English or አማርኛ)</span>
          <span class="label-badge" style="background: var(--accent-purple); color: #fff;">Offline Ollama</span>
        </div>
        <textarea id="ai-input" rows="3" placeholder="Type caller request, e.g.:
• 'I am at Referral Hospital and want to go to Piazza'
• 'ከመናኸሪያ ወደ ሐዋሳ ዩኒቨርሲቲ መሄድ እፈልጋለሁ'
• 'Near Lake fish market, where is the nearest taxi?'" style="width:100%; padding:10px; background:var(--card-bg); border:1px solid var(--border); border-radius:6px; color:#fff; font-size:0.86rem; outline:none; resize:none;"></textarea>
        <button class="btn-action" id="btn-ask-ai" style="background: var(--accent-purple);" onclick="askAIAssistant()">
          ✨ Parse with Offline AI
        </button>
      </div>

      <!-- Quick Search Bar -->
      <div class="input-group" id="search-group">
        <div class="input-label">
          <span>Search Hawassa Places</span>
          <span class="label-badge">English / አማርኛ</span>
        </div>
        <input type="text" id="quick-search" placeholder="🔍 Menharya, መናኸሪያ, ሪፈራል..." oninput="onQuickSearch(this.value)" />
        <div id="search-results-box" style="display: none; max-height: 140px; overflow-y: auto; background: var(--card-bg); border: 1px solid var(--border); border-radius: 6px; padding: 4px;"></div>
      </div>

      <!-- Navigation Inputs Form Container -->
      <div id="navigation-form" style="display: flex; flex-direction: column; gap: 14px;">
        <!-- Caller Location -->
        <div class="input-group">
          <div class="input-label">
            <span>Caller Location</span>
            <span class="label-badge">Step 1</span>
          </div>
          <select id="select-caller" onchange="onSelectCallerPlace()">
            <option value="">-- Choose Landmark or Click Map --</option>
          </select>
          <div class="row-inputs">
            <input type="text" id="input-caller-coords" placeholder="Lat, Lon (e.g. 7.03, 38.48)" />
            <button class="btn-small" id="btn-pick-caller" onclick="armPickMode('caller')">📌 Map</button>
          </div>
        </div>

        <!-- Destination (Full Route Mode Only) -->
        <div class="input-group" id="dest-group" style="display: none;">
          <div class="input-label">
            <span>Destination</span>
            <span class="label-badge">Step 2</span>
          </div>
          <select id="select-dest" onchange="onSelectDestPlace()">
            <option value="">-- Choose Landmark or Click Map --</option>
          </select>
          <div class="row-inputs">
            <input type="text" id="input-dest-coords" placeholder="Lat, Lon (e.g. 7.05, 38.49)" />
            <button class="btn-small" id="btn-pick-dest" onclick="armPickMode('dest')">📌 Map</button>
          </div>

          <div style="margin-top: 6px;">
            <label class="input-label" style="font-size: 0.78rem; margin-bottom: 4px;">Travel Mode</label>
            <div class="mode-selector">
              <button class="mode-tab active" id="costing-auto" onclick="setCosting('auto')">🚗 Auto / Bajaj</button>
              <button class="mode-tab" id="costing-ped" onclick="setCosting('pedestrian')">🚶 Walking</button>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div style="display: flex; gap: 8px;">
          <button class="btn-action" id="btn-submit" style="flex: 2;" onclick="executeAction()">
            🔍 Find Nearest Taxi
          </button>
          <button class="btn-action btn-secondary" style="flex: 1;" onclick="resetForm()">
            Reset
          </button>
        </div>

        <!-- Result Card -->
        <div class="result-box" id="result-box">
          <div class="result-title" id="result-header">📍 Nearest Taxi Station</div>

          <div class="agent-script" id="agent-script">
            Agent response will appear here...
          </div>

          <div class="stat-pills" id="stat-pills"></div>

          <div id="maneuvers-container" style="display: none;">
            <div class="section-title">Turn Directions</div>
            <div class="maneuvers-list" id="maneuvers-list"></div>
          </div>

          <button id="btn-log-call" class="btn-small" style="background: var(--accent-green); color: #000; font-weight: bold; margin-top: 4px;" onclick="logCurrentCall()">
            ✅ Log Call & Dispatch
          </button>
        </div>
      </div>

      <!-- History Container (Hidden by default) -->
      <div id="history-container" style="display: none; flex-direction: column; gap: 10px;">
        <div class="section-title">Today's Call History</div>
        <div id="history-list" style="display: flex; flex-direction: column; gap: 8px;">
          <!-- Dynamically populated -->
        </div>
      </div>
    </div>
  </aside>

  <!-- Map -->
  <main id="map"></main>

  <div class="map-helper">
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <span style="font-weight: 700; color: #fff; font-size: 0.8rem;">📍 Places & POI Layers</span>
      <div style="display: flex; gap: 8px; align-items: center;">
        <span style="font-size: 0.72rem; color: #94a3b8;" id="poi-count-badge">257 Places</span>
        <button id="btn-3d" onclick="toggle3DView()" style="padding: 2px 8px; font-size: 11px; background: #2563eb; color: #fff; border: 1px solid #60a5fa; border-radius: 4px; cursor: pointer; font-weight: 600;">🏢 3D View</button>
      </div>
    </div>
    <div class="poi-filter-bar">
      <div class="poi-chip active" data-cat="all" onclick="togglePOIFilter('all')">All</div>
      <div class="poi-chip" data-cat="taxi_station" onclick="togglePOIFilter('taxi_station')">🚖 Taxis (24)</div>
      <div class="poi-chip" data-cat="hotel" onclick="togglePOIFilter('hotel')">🏨 Hotels (55)</div>
      <div class="poi-chip" data-cat="bank" onclick="togglePOIFilter('bank')">🏦 Banks (13)</div>
      <div class="poi-chip" data-cat="hospital" onclick="togglePOIFilter('hospital')">🏥 Health (5)</div>
      <div class="poi-chip" data-cat="fuel" onclick="togglePOIFilter('fuel')">⛽ Fuel (5)</div>
      <div class="poi-chip" data-cat="restaurant" onclick="togglePOIFilter('restaurant')">🍽️ Food (43)</div>
      <div class="poi-chip" data-cat="worship" onclick="togglePOIFilter('worship')">⛪ Worship (16)</div>
      <div class="poi-chip" data-cat="school" onclick="togglePOIFilter('school')">🎓 Schools (19)</div>
    </div>
    <div class="legend-row">
      <span style="display:inline-flex; align-items:center; gap:4px;"><span class="legend-icon legend-caller"></span> Caller</span>
      <span style="display:inline-flex; align-items:center; gap:4px;"><span class="legend-icon legend-dest"></span> Dest</span>
      <span style="font-size:0.7rem; color:#94a3b8; margin-left:auto;">Click map to set caller / destination</span>
    </div>
  </div>

  <!-- Add Station Modal -->
  <div class="modal-backdrop" id="add-place-modal">
    <div class="modal-box" style="width: 400px;">
      <h3 style="font-size: 1.1rem; display: flex; align-items: center; gap: 6px;">
        🚖 Add New Taxi / Bajaj Station
      </h3>
      <p style="font-size: 0.8rem; color: var(--text-muted);">
        Enter new terminal details. It will be immediately available for dispatch and map routing.
      </p>
      <input type="text" id="new-station-name" placeholder="Station Name (e.g. Millennium North Stand)" />
      <input type="text" id="new-station-name-am" placeholder="Name in Amharic (e.g. ሚሊኒየም ሰሜን ማቆሚያ)" />
      <div class="row-inputs">
        <input type="text" id="new-station-coords" placeholder="Lat, Lon (e.g. 7.0543, 38.4812)" />
        <button class="btn-small" id="btn-pick-new-station" onclick="armPickMode('new_station')">📌 Map</button>
      </div>
      <input type="text" id="new-station-aliases" placeholder="Search aliases (e.g. millenium, 05 gate)" />
      <input type="text" id="new-station-desc" placeholder="Description / Landmark notes" />
      <div style="display: flex; gap: 8px; justify-content: flex-end; margin-top: 6px;">
        <button class="btn-small" onclick="toggleAddPlaceModal(false)">Cancel</button>
        <button class="btn-small" style="background: var(--accent-green); color: #000; font-weight: bold;" id="btn-save-station" onclick="saveNewStation()">Save Station</button>
      </div>
    </div>
  </div>
  <div class="modal-backdrop" id="auth-modal">
    <div class="modal-box">
      <h3 style="font-size: 1.1rem; display: flex; align-items: center; gap: 6px;">
        👤 Agent Login
      </h3>
      <p style="font-size: 0.8rem; color: var(--text-muted);">
        Enter call center operator credentials (default: <b>admin / admin123</b> or <b>agent1 / agent123</b>).
      </p>
      <input type="text" id="login-username" placeholder="Username" value="agent1" />
      <input type="password" id="login-password" placeholder="Password" value="agent123" />
      <div style="display: flex; gap: 8px; justify-content: flex-end; margin-top: 6px;">
        <button class="btn-small" onclick="toggleAuthModal(false)">Cancel</button>
        <button class="btn-small" style="background: var(--primary); color: #fff;" onclick="performLogin()">Login</button>
      </div>
    </div>
  </div>

  <script>
    let currentAgent = null;
    let appMode = 'nearest';
    let travelCosting = 'auto';
    let pickMode = null;

    let callerMarker = null;
    let destMarker = null;
    let stationMarkers = [];
    let routeSourceAdded = false;
    let walkSourceAdded = false;

    let placesList = [];
    let lastSearchResult = null;
    let poiMarkersMap = {}; // id -> maplibre Marker

    // ==========================================
    // 100% Offline MapLibre GL JS Initialization
    // ==========================================
    const tileServerUrl = `${window.location.protocol}//${window.location.hostname || 'localhost'}:8081`;
    const map = new maplibregl.Map({
      container: 'map',
      style: `${tileServerUrl}/styles/hawassa/style.json`,
      center: [38.475, 7.06],
      zoom: 13,
      maxZoom: 19,
      maxPitch: 65,
      pitchWithRotate: true
    });

    map.addControl(new maplibregl.NavigationControl({ visualizePitch: true }), 'top-left');
    map.addControl(new maplibregl.ScaleControl({ unit: 'metric' }), 'bottom-right');

    let is3DMode = false;
    function toggle3DView() {
      is3DMode = !is3DMode;
      const btn = document.getElementById('btn-3d');
      if (is3DMode) {
        map.easeTo({ pitch: 55, bearing: -20, duration: 1200 });
        btn.textContent = '🗺️ 2D View';
        btn.style.background = '#10b981';
        btn.style.borderColor = '#34d399';
      } else {
        map.easeTo({ pitch: 0, bearing: 0, duration: 1000 });
        btn.textContent = '🏢 3D View';
        btn.style.background = '#2563eb';
        btn.style.borderColor = '#60a5fa';
      }
    }

    // Map click handler
    map.on('click', (e) => {
      const lat = parseFloat(e.lngLat.lat.toFixed(6));
      const lon = parseFloat(e.lngLat.lng.toFixed(6));

      if (pickMode === 'new_station') {
        document.getElementById('new-station-coords').value = `${lat}, ${lon}`;
        toggleAddPlaceModal(true);
        pickMode = null;
        updatePickButtons();
        return;
      }

      if (pickMode === 'dest' || (appMode === 'route' && callerMarker && !destMarker)) {
        setDestCoords(lat, lon);
        pickMode = null;
      } else {
        setCallerCoords(lat, lon);
        pickMode = null;
      }
      updatePickButtons();
    });

    function armPickMode(target) {
      pickMode = (pickMode === target) ? null : target;
      updatePickButtons();
      map.getCanvas().style.cursor = pickMode ? 'crosshair' : '';
    }

    function updatePickButtons() {
      document.getElementById('btn-pick-caller').classList.toggle('active', pickMode === 'caller');
      document.getElementById('btn-pick-dest').classList.toggle('active', pickMode === 'dest');
      const btnNew = document.getElementById('btn-pick-new-station');
      if (btnNew) btnNew.classList.toggle('active', pickMode === 'new_station');
    }

    // Helper: create a colored pin element
    function makePinEl(color) {
      const el = document.createElement('div');
      el.style.cssText = `width:28px;height:40px;cursor:pointer;background:url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 28 40"><path fill="${encodeURIComponent(color)}" stroke="%23fff" stroke-width="1.5" d="M14 0C6.27 0 0 6.27 0 14c0 10.5 14 26 14 26s14-15.5 14-26C28 6.27 21.73 0 14 0z"/><circle cx="14" cy="14" r="6" fill="%23fff" opacity="0.85"/></svg>') no-repeat center/contain`;
      return el;
    }

    function setCallerCoords(lat, lon, placeName = '') {
      document.getElementById('input-caller-coords').value = `${lat}, ${lon}`;
      if (callerMarker) callerMarker.remove();
      const popup = new maplibregl.Popup({ offset: 30, closeButton: true })
        .setHTML(`<b style="color:#10b981">📍 Caller Location</b><br>${placeName || `${lat}, ${lon}`}`);
      callerMarker = new maplibregl.Marker({ element: makePinEl('#10b981'), anchor: 'bottom' })
        .setLngLat([lon, lat])
        .setPopup(popup)
        .addTo(map);
      callerMarker.togglePopup();
    }

    function setDestCoords(lat, lon, placeName = '') {
      document.getElementById('input-dest-coords').value = `${lat}, ${lon}`;
      if (destMarker) destMarker.remove();
      const popup = new maplibregl.Popup({ offset: 30, closeButton: true })
        .setHTML(`<b style="color:#ef4444">🏁 Destination</b><br>${placeName || `${lat}, ${lon}`}`);
      destMarker = new maplibregl.Marker({ element: makePinEl('#ef4444'), anchor: 'bottom' })
        .setLngLat([lon, lat])
        .setPopup(popup)
        .addTo(map);
      destMarker.togglePopup();
    }

    // Helper: add or update a GeoJSON line source/layer on the map
    function upsertLineLayer(sourceId, layerId, coordinates, color, width, dashArray) {
      const apply = () => {
        const geojson = {
          type: 'Feature',
          geometry: { type: 'LineString', coordinates: coordinates.map(([lt,ln]) => [ln, lt]) }
        };
        if (map.getSource(sourceId)) {
          map.getSource(sourceId).setData(geojson);
        } else {
          map.addSource(sourceId, { type: 'geojson', data: geojson });
          const layerSpec = {
            id: layerId, type: 'line', source: sourceId,
            layout: { 'line-join': 'round', 'line-cap': 'round' },
            paint: { 'line-color': color, 'line-width': width, 'line-opacity': 0.9 }
          };
          if (dashArray) layerSpec.paint['line-dasharray'] = dashArray;
          map.addLayer(layerSpec);
        }
      };
      if (map.loaded()) {
        apply();
      } else {
        map.once('load', apply);
      }
    }

    function removeLineLayer(sourceId, layerId) {
      if (map.getLayer(layerId)) map.removeLayer(layerId);
      if (map.getSource(sourceId)) map.removeSource(sourceId);
    }

    function fitCoords(coordPairs, padding = 60) {
      // coordPairs: [[lat,lon], ...]
      if (!coordPairs.length) return;
      const lngs = coordPairs.map(c => c[1]);
      const lats = coordPairs.map(c => c[0]);
      map.fitBounds([[Math.min(...lngs), Math.min(...lats)], [Math.max(...lngs), Math.max(...lats)]], { padding });
    }

    function setAppMode(mode) {
      appMode = mode;
      document.getElementById('tab-nearest').classList.toggle('active', mode === 'nearest');
      document.getElementById('tab-route').classList.toggle('active', mode === 'route');
      document.getElementById('tab-ai').classList.toggle('active', mode === 'ai');
      document.getElementById('tab-history').classList.toggle('active', mode === 'history');


      if (mode === 'history') {
        document.getElementById('navigation-form').style.display = 'none';
        document.getElementById('ai-container').style.display = 'none';
        document.getElementById('search-group').style.display = 'none';
        document.getElementById('history-container').style.display = 'flex';
        loadRecentCalls();
      } else if (mode === 'ai') {
        document.getElementById('navigation-form').style.display = 'none';
        document.getElementById('ai-container').style.display = 'flex';
        document.getElementById('search-group').style.display = 'none';
        document.getElementById('history-container').style.display = 'none';
      } else {
        document.getElementById('navigation-form').style.display = 'flex';
        document.getElementById('ai-container').style.display = 'none';
        document.getElementById('search-group').style.display = 'flex';
        document.getElementById('history-container').style.display = 'none';
        document.getElementById('dest-group').style.display = (mode === 'route') ? 'flex' : 'none';
        document.getElementById('btn-submit').textContent = (mode === 'nearest') ? '🔍 Find Nearest Taxi' : '🚀 Calculate Full Route';
      }
      clearResults();
    }

    async function askAIAssistant() {
      const text = document.getElementById('ai-input').value.trim();
      if (!text) {
        alert('Please enter a caller statement or question.');
        return;
      }

      const btn = document.getElementById('btn-ask-ai');
      btn.textContent = '⏳ Thinking...';
      btn.disabled = true;

      try {
        const res = await fetch('/api/ai/dispatch', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text })
        });
        const data = await res.json();
        if (res.status !== 200) throw new Error(data.detail || 'AI parsing error');

        // Set caller marker
        if (data.origin) {
          setCallerCoords(data.origin.lat, data.origin.lon, data.origin.name);
        }

        // Set dest marker and draw route if present
        if (data.destination) {
          setDestCoords(data.destination.lat, data.destination.lon, data.destination.name);
        }

        if (data.route && data.route.coordinates) {
          upsertLineLayer('route-src', 'route-line', data.route.coordinates, '#2563eb', 6, null);
          fitCoords(data.route.coordinates);
        } else if (data.nearest_station) {
          map.flyTo({ center: [data.origin.lon, data.origin.lat], zoom: 15 });
        }

        lastSearchResult = {
          type: data.destination ? 'route' : 'nearest',
          caller_lat: data.origin.lat,
          caller_lon: data.origin.lon,
          dest_lat: data.destination ? data.destination.lat : null,
          dest_lon: data.destination ? data.destination.lon : null,
          nearest_station: data.nearest_station.name,
          distance_m: data.route ? data.route.distance_m : data.nearest_station.distance_m,
          duration_min: data.route ? data.route.duration_min : 1,
          travel_mode: 'auto'
        };

        // Render AI Result
        document.getElementById('result-box').classList.add('visible');
        document.getElementById('result-header').textContent = `🤖 AI Dispatch Proposal`;

        document.getElementById('agent-script').innerHTML = `
          <div style="margin-bottom: 6px;"><b>🇬🇧 English Talk-Track:</b><br>"${data.script_en}"</div>
          <div style="border-top: 1px solid #475569; padding-top: 6px;"><b>🇪🇹 Amharic (አማርኛ) Talk-Track:</b><br>"${data.script_am}"</div>
        `;

        document.getElementById('stat-pills').innerHTML = `
          <div class="stat-pill">Origin: <strong>${data.origin.name}</strong></div>
          ${data.destination ? `<div class="stat-pill">Dest: <strong>${data.destination.name}</strong></div>` : ''}
          <div class="stat-pill">Station: <strong>${data.nearest_station.name}</strong></div>
          <div class="stat-pill">Walk: <strong>${data.nearest_station.distance_m} m</strong></div>
          ${data.route ? `<div class="stat-pill">Trip: <strong>${(data.route.distance_m/1000).toFixed(2)} km</strong></div>` : ''}
        `;

        // Switch to form view showing the result card
        document.getElementById('navigation-form').style.display = 'flex';

      } catch (err) {
        alert('AI Assistant Error: ' + err.message);
      } finally {
        btn.textContent = '✨ Parse with Offline AI';
        btn.disabled = false;
      }
    }

    function setCosting(costing) {
      travelCosting = costing;
      document.getElementById('costing-auto').classList.toggle('active', costing === 'auto');
      document.getElementById('costing-ped').classList.toggle('active', costing === 'pedestrian');
    }

    // ==========================================
    // Auth Management
    // ==========================================
    function getAuthHeaders() {
      const token = localStorage.getItem('hawassa_agent_token');
      return token ? { 'Authorization': `Bearer ${token}` } : {};
    }

    async function checkCurrentSession() {
      const token = localStorage.getItem('hawassa_agent_token');
      if (!token) return;
      try {
        const res = await fetch('/api/auth/me', { headers: getAuthHeaders() });
        if (res.status === 200) {
          currentAgent = await res.json();
          document.getElementById('agent-label').textContent = `${currentAgent.username} (${currentAgent.role})`;
          document.getElementById('agent-status-dot').className = 'dot';
        } else {
          localStorage.removeItem('hawassa_agent_token');
        }
      } catch (e) {
        console.error(e);
      }
    }

    function toggleAuthModal(show = true) {
      if (currentAgent && show) {
        if (confirm(`Logged in as ${currentAgent.full_name}. Do you want to logout?`)) {
          logoutAgent();
        }
        return;
      }
      document.getElementById('auth-modal').style.display = show ? 'flex' : 'none';
    }

    async function performLogin() {
      const u = document.getElementById('login-username').value.trim();
      const p = document.getElementById('login-password').value.trim();
      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username: u, password: p })
        });
        if (res.status === 200) {
          const data = await res.json();
          localStorage.setItem('hawassa_agent_token', data.token);
          currentAgent = data;
          document.getElementById('agent-label').textContent = `${data.username} (${data.role})`;
          document.getElementById('agent-status-dot').className = 'dot';
          toggleAuthModal(false);
        } else {
          alert('Invalid credentials');
        }
      } catch (err) {
        alert('Login failed: ' + err.message);
      }
    }

    async function logoutAgent() {
      await fetch('/api/auth/logout', { method: 'POST', headers: getAuthHeaders() });
      localStorage.removeItem('hawassa_agent_token');
      currentAgent = null;
      document.getElementById('agent-label').textContent = 'Agent Login';
      document.getElementById('agent-status-dot').className = 'dot offline';
    }

    function toggleAddPlaceModal(show = true) {
      document.getElementById('add-place-modal').style.display = show ? 'flex' : 'none';
      if (!show && pickMode === 'new_station') {
        pickMode = null;
        updatePickButtons();
      }
    }

    async function saveNewStation() {
      const name = document.getElementById('new-station-name').value.trim();
      const name_am = document.getElementById('new-station-name-am').value.trim();
      const coordsStr = document.getElementById('new-station-coords').value.trim();
      const aliases = document.getElementById('new-station-aliases').value.trim();
      const desc = document.getElementById('new-station-desc').value.trim();

      const coords = parseCoords(coordsStr);
      if (!name) { alert('Please enter station name'); return; }
      if (!coords) { alert('Please enter valid coordinates (Lat, Lon) or click Map'); return; }

      const btn = document.getElementById('btn-save-station');
      btn.textContent = 'Saving...';
      btn.disabled = true;

      try {
        const res = await fetch('/api/places', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', ...getAuthHeaders() },
          body: JSON.stringify({
            name: name,
            name_am: name_am,
            category: 'taxi_station',
            latitude: coords.lat,
            longitude: coords.lon,
            aliases: aliases,
            description: desc
          })
        });
        const data = await res.json();
        if (res.status === 200) {
          alert(`✅ Added station: ${name}`);
          toggleAddPlaceModal(false);
          document.getElementById('new-station-name').value = '';
          document.getElementById('new-station-name-am').value = '';
          document.getElementById('new-station-coords').value = '';
          document.getElementById('new-station-aliases').value = '';
          document.getElementById('new-station-desc').value = '';
          loadInitialData();
        } else {
          alert(data.detail || 'Failed to add station');
        }
      } catch (err) {
        alert('Error: ' + err.message);
      } finally {
        btn.textContent = 'Save Station';
        btn.disabled = false;
      }
    }

    // ==========================================
    // Places and Map Setup
    // ==========================================
    async function loadInitialData() {
      try {
        checkCurrentSession();

        const statusRes = await fetch('/api/status');
        const status = await statusRes.json();
        
        document.getElementById('db-status').textContent = `${status.database.place_count} Places`;
        document.getElementById('db-dot').className = status.database.connected ? 'dot' : 'dot offline';

        document.getElementById('valhalla-status').textContent = status.routing_engine.online ? 'Valhalla Online' : 'Valhalla Offline';
        document.getElementById('valhalla-dot').className = status.routing_engine.online ? 'dot' : 'dot offline';

        try {
          const mapCheck = await fetch(`${tileServerUrl}/health`);
          document.getElementById('map-dot').className = mapCheck.ok ? 'dot' : 'dot offline';
          document.getElementById('map-status').textContent = mapCheck.ok ? 'Offline Map Active' : 'Map Server Offline';
        } catch (e) {
          document.getElementById('map-dot').className = 'dot offline';
          document.getElementById('map-status').textContent = 'Map Server Offline';
        }

        const placesRes = await fetch('/api/places');
        const data = await placesRes.json();
        placesList = data.places || [];

        populatePlaceDropdowns(placesList);
        plotTaxiPoints(placesList);

        // Load stats
        const statsRes = await fetch('/api/calls/stats');
        const statsData = await statsRes.json();
        document.getElementById('total-calls-badge').textContent = statsData.total_calls;

      } catch (err) {
        console.error('Failed to load initial data', err);
      }
    }


    let currentPOIFilter = 'all';

    const CATEGORY_META = {
      'taxi_station': { label: '🚖 Taxi/Bajaj Station', color: '#2563eb' },
      'hotel':        { label: '🏨 Hotel / Resort',     color: '#8b5cf6' },
      'bank':         { label: '🏦 Bank / ATM',         color: '#10b981' },
      'hospital':     { label: '🏥 Hospital / Clinic',  color: '#ef4444' },
      'fuel':         { label: '⛽ Fuel Station',       color: '#eab308' },
      'restaurant':   { label: '🍽️ Food & Cafe',        color: '#f97316' },
      'worship':      { label: '⛪ Place of Worship',   color: '#d97706' },
      'school':       { label: '🎓 Education',          color: '#06b6d4' },
      'landmark':     { label: '🏛️ Landmark',          color: '#64748b' },
      'market':       { label: '🛒 Market',             color: '#ea580c' }
    };

    const CATEGORY_EMOJI = {
      taxi_station:'🚖', hotel:'🏨', bank:'🏦', hospital:'🏥',
      fuel:'⛽', restaurant:'🍽', worship:'⛪', school:'🎓',
      landmark:'🏛', market:'🛒'
    };

    function togglePOIFilter(cat) {
      currentPOIFilter = cat;
      document.querySelectorAll('.poi-chip').forEach(el => {
        el.classList.toggle('active', el.getAttribute('data-cat') === cat);
      });
      renderPOIMarkers();
    }

    function populatePlaceDropdowns(places) {
      const selectCaller = document.getElementById('select-caller');
      const selectDest = document.getElementById('select-dest');

      selectCaller.innerHTML = '<option value="">-- Choose Landmark or Click Map --</option>';
      selectDest.innerHTML = '<option value="">-- Choose Landmark or Click Map --</option>';

      const groupsCaller = {};
      const groupsDest = {};

      Object.keys(CATEGORY_META).forEach(k => {
        const g1 = document.createElement('optgroup');
        g1.label = CATEGORY_META[k].label;
        groupsCaller[k] = g1;

        const g2 = document.createElement('optgroup');
        g2.label = CATEGORY_META[k].label;
        groupsDest[k] = g2;
      });

      places.forEach(p => {
        const cat = p.category || 'landmark';
        const label = p.name_am ? `${p.name} (${p.name_am})` : p.name;

        const opt1 = document.createElement('option');
        opt1.value = `${p.lat},${p.lon}`;
        opt1.textContent = label;

        const opt2 = document.createElement('option');
        opt2.value = `${p.lat},${p.lon}`;
        opt2.textContent = label;

        if (groupsCaller[cat]) groupsCaller[cat].appendChild(opt1);
        if (groupsDest[cat]) groupsDest[cat].appendChild(opt2);
      });

      ['taxi_station','hotel','bank','hospital','fuel','restaurant','worship','school','market','landmark'].forEach(k => {
        if (groupsCaller[k] && groupsCaller[k].children.length > 0) {
          selectCaller.appendChild(groupsCaller[k]);
          selectDest.appendChild(groupsDest[k]);
        }
      });
    }

    function renderPOIMarkers() {
      stationMarkers.forEach(m => m.remove());
      stationMarkers = [];

      placesList.forEach(p => {
        const cat = p.category || 'landmark';
        if (currentPOIFilter !== 'all' && currentPOIFilter !== cat) return;

        const meta = CATEGORY_META[cat] || CATEGORY_META['landmark'];
        const emoji = CATEGORY_EMOJI[cat] || '📍';

        const el = document.createElement('div');
        el.title = p.name;
        el.style.cssText = [
          'width:22px','height:22px','border-radius:50%','cursor:pointer',
          `background:${meta.color}`,'border:2px solid rgba(255,255,255,0.9)',
          'box-shadow:0 2px 6px rgba(0,0,0,0.5)',
          'display:flex','align-items:center','justify-content:center',
          'font-size:11px','line-height:1','user-select:none'
        ].join(';');
        el.textContent = emoji;

        const safeName = p.name.replace(/'/g, "\\'").replace(/"/g, '&quot;');
        const popupHtml = `
          <div style="font-size:13px;line-height:1.5;min-width:180px;">
            <div style="font-size:10px;font-weight:700;color:${meta.color};text-transform:uppercase;margin-bottom:2px;">${meta.label}</div>
            <b style="font-size:14px;color:#f8fafc;">${p.name}</b><br>
            ${p.name_am ? `<span style="font-size:12px;color:#94a3b8;"><b>${p.name_am}</b></span><br>` : ''}
            <i style="color:#cbd5e1;font-size:12px;">${p.description || ''}</i>
            <div style="font-size:11px;color:#64748b;margin-top:2px;">${p.lat.toFixed(5)}, ${p.lon.toFixed(5)}</div>
            <div style="margin-top:8px;display:flex;gap:6px;">
              <button onclick="setCallerCoords(${p.lat},${p.lon},'${safeName}');closeActivePopup();"
                style="padding:4px 8px;font-size:11px;background:#10b981;color:#fff;border:none;border-radius:4px;cursor:pointer;">
                📍 Set Caller
              </button>
              <button onclick="setDestCoords(${p.lat},${p.lon},'${safeName}');closeActivePopup();"
                style="padding:4px 8px;font-size:11px;background:#ef4444;color:#fff;border:none;border-radius:4px;cursor:pointer;">
                🏁 Set Dest
              </button>
            </div>
          </div>`;

        const popup = new maplibregl.Popup({ offset: 14, closeButton: true }).setHTML(popupHtml);
        const marker = new maplibregl.Marker({ element: el, anchor: 'center' })
          .setLngLat([p.lon, p.lat])
          .setPopup(popup)
          .addTo(map);

        stationMarkers.push(marker);
      });
    }

    function closeActivePopup() {
      document.querySelectorAll('.maplibregl-popup').forEach(el => el.remove());
    }

    function plotTaxiPoints(places) {
      renderPOIMarkers();
    }

    let searchTimer = null;
    function onQuickSearch(val) {
      clearTimeout(searchTimer);
      const box = document.getElementById('search-results-box');
      if (!val || val.trim().length === 0) {
        box.style.display = 'none';
        box.innerHTML = '';
        return;
      }

      searchTimer = setTimeout(async () => {
        try {
          const res = await fetch(`/api/search?q=${encodeURIComponent(val.trim())}`);
          const data = await res.json();
          if (data.results && data.results.length > 0) {
            box.style.display = 'block';
            box.innerHTML = '';
            data.results.forEach(p => {
              const item = document.createElement('div');
              item.style.cssText = 'padding:6px 8px;font-size:12px;border-bottom:1px solid #475569;cursor:pointer;display:flex;justify-content:space-between;align-items:center;';
              item.innerHTML = `
                <div>
                  <strong>${p.name}</strong> ${p.name_am ? `<span style="color:#94a3b8;">(${p.name_am})</span>` : ''}
                  <div style="font-size:10px;color:#94a3b8;">${p.category === 'taxi_station' ? '🚖 Taxi' : '🏛️ Landmark'}</div>
                </div>
                <div style="display:flex;gap:4px;">
                  <button style="padding:2px 6px;font-size:10px;background:#10b981;color:#fff;border:none;border-radius:3px;cursor:pointer;">Caller</button>
                  <button style="padding:2px 6px;font-size:10px;background:#ef4444;color:#fff;border:none;border-radius:3px;cursor:pointer;">Dest</button>
                </div>`;
              const btns = item.querySelectorAll('button');
              btns[0].onclick = (e) => {
                e.stopPropagation();
                setCallerCoords(p.lat, p.lon, p.name);
                map.flyTo({ center: [p.lon, p.lat], zoom: 16 });
                box.style.display = 'none';
              };
              btns[1].onclick = (e) => {
                e.stopPropagation();
                setDestCoords(p.lat, p.lon, p.name);
                map.flyTo({ center: [p.lon, p.lat], zoom: 16 });
                box.style.display = 'none';
              };
              box.appendChild(item);
            });
          } else {
            box.style.display = 'block';
            box.innerHTML = '<div style="padding:6px;font-size:12px;color:#94a3b8;">No matching places found.</div>';
          }
        } catch (e) {
          console.error('Search error', e);
        }
      }, 200);
    }

    function onSelectCallerPlace() {
      const val = document.getElementById('select-caller').value;
      if (!val) return;
      const [lat, lon] = val.split(',').map(Number);
      const opt = document.getElementById('select-caller').selectedOptions[0];
      setCallerCoords(lat, lon, opt.textContent);
      map.flyTo({ center: [lon, lat], zoom: 15 });
    }

    function onSelectDestPlace() {
      const val = document.getElementById('select-dest').value;
      if (!val) return;
      const [lat, lon] = val.split(',').map(Number);
      const opt = document.getElementById('select-dest').selectedOptions[0];
      setDestCoords(lat, lon, opt.textContent);
      map.flyTo({ center: [lon, lat], zoom: 15 });
    }

    function parseCoords(str) {
      if (!str || !str.includes(',')) return null;
      const parts = str.split(',').map(s => parseFloat(s.trim()));
      if (parts.length === 2 && !isNaN(parts[0]) && !isNaN(parts[1])) {
        return { lat: parts[0], lon: parts[1] };
      }
      return null;
    }

    async function executeAction() {
      const callerStr = document.getElementById('input-caller-coords').value;
      const callerCoords = parseCoords(callerStr);

      if (!callerCoords) {
        alert('Please choose or click a valid Caller Location on the map.');
        return;
      }

      if (appMode === 'nearest') {
        await findNearestTaxi(callerCoords.lat, callerCoords.lon);
      } else {
        const destStr = document.getElementById('input-dest-coords').value;
        const destCoords = parseCoords(destStr);
        if (!destCoords) {
          alert('Please choose or click a valid Destination on the map.');
          return;
        }
        await calculateFullRoute(callerCoords, destCoords);
      }
    }

    async function findNearestTaxi(lat, lon) {
      try {
        const res = await fetch('/api/nearest-taxi', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ lat, lon })
        });
        const data = await res.json();
        const nearest = data.nearest;

        lastSearchResult = {
          type: 'nearest',
          caller_lat: lat, caller_lon: lon,
          nearest_station: nearest.name,
          distance_m: nearest.distance_m,
          duration_min: data.walk_route ? data.walk_route.duration_min : 1,
          travel_mode: 'pedestrian'
        };

        document.getElementById('result-box').classList.add('visible');
        document.getElementById('result-header').textContent = `📍 Nearest: ${nearest.name}`;

        const walk = data.walk_route;
        const distText = walk
          ? `${walk.distance_m} m (${walk.duration_min} min walk)`
          : `${nearest.distance_m} m direct`;

        document.getElementById('agent-script').innerHTML = `
          <b>Agent Talk-Track for Caller:</b><br>
          "The closest taxi station to your position is <b>${nearest.name}</b>, approximately <b>${distText}</b> away.
          ${nearest.description ? `<i>(${nearest.description})</i>` : ''}"`;

        document.getElementById('stat-pills').innerHTML = `
          <div class="stat-pill">Terminal: <strong>${nearest.name}</strong></div>
          <div class="stat-pill">Distance: <strong>${nearest.distance_m} m</strong></div>
          <div class="stat-pill">GPS: <strong>${nearest.lat.toFixed(5)}, ${nearest.lon.toFixed(5)}</strong></div>`;

        removeLineLayer('walk-src', 'walk-line');
        if (walk && walk.coordinates) {
          upsertLineLayer('walk-src', 'walk-line', walk.coordinates, '#10b981', 5, [8, 6]);
          fitCoords(walk.coordinates, 60);
        } else {
          upsertLineLayer('walk-src', 'walk-line', [[lat, lon], [nearest.lat, nearest.lon]], '#10b981', 3, [5, 5]);
          fitCoords([[lat, lon], [nearest.lat, nearest.lon]], 80);
        }

        document.getElementById('maneuvers-container').style.display = 'none';

      } catch (err) {
        alert('Error fetching nearest taxi: ' + err.message);
      }
    }

    async function calculateFullRoute(caller, dest) {
      try {
        const [nearestRes, routeRes] = await Promise.all([
          fetch('/api/nearest-taxi', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ lat: caller.lat, lon: caller.lon })
          }),
          fetch('/api/route', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              start_lat: caller.lat, start_lon: caller.lon,
              end_lat: dest.lat, end_lon: dest.lon,
              costing: travelCosting
            })
          })
        ]);

        const nearestData = await nearestRes.json();
        const routeData = await routeRes.json();
        const nearest = nearestData.nearest;

        lastSearchResult = {
          type: 'route',
          caller_lat: caller.lat, caller_lon: caller.lon,
          dest_lat: dest.lat, dest_lon: dest.lon,
          nearest_station: nearest.name,
          distance_m: routeData.distance_m,
          duration_min: routeData.duration_min,
          travel_mode: travelCosting
        };

        document.getElementById('result-box').classList.add('visible');
        document.getElementById('result-header').textContent = `🗺️ Route (${travelCosting})`;

        document.getElementById('agent-script').innerHTML = `
          <b>Agent Talk-Track for Caller:</b><br>
          "1. Nearest taxi station is <b>${nearest.name}</b> (${nearest.distance_m} m from you).<br>
          2. Total route to destination: <b>${(routeData.distance_m / 1000).toFixed(2)} km</b> (~<b>${routeData.duration_min} min</b>)."`;

        document.getElementById('stat-pills').innerHTML = `
          <div class="stat-pill">Distance: <strong>${(routeData.distance_m/1000).toFixed(2)} km</strong></div>
          <div class="stat-pill">Est. Time: <strong>${routeData.duration_min} min</strong></div>
          <div class="stat-pill">Mode: <strong>${travelCosting}</strong></div>
          <div class="stat-pill">Engine: <strong>${routeData.engine}</strong></div>`;

        const maneuversList = document.getElementById('maneuvers-list');
        maneuversList.innerHTML = '';
        if (routeData.maneuvers && routeData.maneuvers.length > 0) {
          routeData.maneuvers.forEach((m, idx) => {
            const item = document.createElement('div');
            item.className = 'maneuver-item';
            item.innerHTML = `<span style="color:#38bdf8;font-weight:bold;">${idx + 1}.</span> <span>${m.instruction} (${m.distance_m} m)</span>`;
            maneuversList.appendChild(item);
          });
          document.getElementById('maneuvers-container').style.display = 'block';
        } else {
          document.getElementById('maneuvers-container').style.display = 'none';
        }

        removeLineLayer('walk-src', 'walk-line');
        removeLineLayer('route-src', 'route-line');

        const routeColor = travelCosting === 'pedestrian' ? '#10b981' : '#2563eb';
        upsertLineLayer('route-src', 'route-line', routeData.coordinates, routeColor, 6, null);
        fitCoords(routeData.coordinates, 70);

      } catch (err) {
        alert('Error calculating route: ' + err.message);
      }
    }

    async function logCurrentCall() {
      if (!lastSearchResult) return;
      try {
        const callerNameOpt = document.getElementById('select-caller').selectedOptions[0];
        const destNameOpt = document.getElementById('select-dest').selectedOptions[0];

        const payload = {
          caller_name: callerNameOpt ? callerNameOpt.textContent : 'Caller',
          caller_lat: lastSearchResult.caller_lat,
          caller_lon: lastSearchResult.caller_lon,
          dest_name: destNameOpt ? destNameOpt.textContent : '',
          dest_lat: lastSearchResult.dest_lat || null,
          dest_lon: lastSearchResult.dest_lon || null,
          nearest_station: lastSearchResult.nearest_station,
          distance_m: lastSearchResult.distance_m,
          duration_min: lastSearchResult.duration_min,
          travel_mode: lastSearchResult.travel_mode,
          status: 'dispatched'
        };

        const res = await fetch('/api/calls/log', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', ...getAuthHeaders() },
          body: JSON.stringify(payload)
        });
        if (res.status === 200) {
          const btn = document.getElementById('btn-log-call');
          btn.textContent = '✓ Call Logged!';
          btn.style.background = '#475569';
          setTimeout(() => {
            btn.textContent = '✅ Log Call & Dispatch';
            btn.style.background = 'var(--accent-green)';
          }, 2000);
          const statsRes = await fetch('/api/calls/stats');
          const statsData = await statsRes.json();
          document.getElementById('total-calls-badge').textContent = statsData.total_calls;
        }
      } catch (err) {
        alert('Failed to log call: ' + err.message);
      }
    }

    async function loadRecentCalls() {
      try {
        const res = await fetch('/api/calls/recent?limit=15');
        const data = await res.json();
        const list = document.getElementById('history-list');
        list.innerHTML = '';

        if (!data.calls || data.calls.length === 0) {
          list.innerHTML = '<div style="font-size:0.8rem;color:#94a3b8;">No dispatch calls recorded yet today.</div>';
          return;
        }

        data.calls.forEach(c => {
          const card = document.createElement('div');
          card.className = 'history-card';
          const timeStr = new Date(c.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
          card.innerHTML = `
            <div style="display:flex;justify-content:space-between;font-weight:bold;color:#38bdf8;">
              <span>🚖 ${c.nearest_station}</span>
              <span style="color:#94a3b8;font-size:0.72rem;">${timeStr}</span>
            </div>
            <div style="color:#e2e8f0;">Caller: ${c.caller_name || `${c.caller_lat.toFixed(3)}, ${c.caller_lon.toFixed(3)}`}</div>
            <div style="display:flex;justify-content:space-between;color:#94a3b8;font-size:0.75rem;margin-top:4px;">
              <span>Distance: <b>${c.distance_m} m</b></span>
              <span>Operator: <b>${c.agent_username}</b></span>
            </div>`;
          list.appendChild(card);
        });
      } catch (e) {
        console.error(e);
      }
    }

    function clearResults() {
      document.getElementById('result-box').classList.remove('visible');
      removeLineLayer('route-src', 'route-line');
      removeLineLayer('walk-src', 'walk-line');
    }

    function resetForm() {
      clearResults();
      if (callerMarker) { callerMarker.remove(); callerMarker = null; }
      if (destMarker) { destMarker.remove(); destMarker = null; }
      document.getElementById('input-caller-coords').value = '';
      document.getElementById('input-dest-coords').value = '';
      document.getElementById('select-caller').value = '';
      document.getElementById('select-dest').value = '';
      map.flyTo({ center: [38.475, 7.06], zoom: 13 });
    }

    // Startup
    loadInitialData();
  </script>
</body>
</html>
