[Unit]
Description=Hawassa Call Center Navigation & Dispatch Web Service
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=anley
WorkingDirectory=/home/anley/dogo
EnvironmentFile=-/home/anley/dogo/.env
ExecStart=/home/anley/miniconda3/bin/uvicorn web_app:app --host 0.0.0.0 --port 8080 --workers 2
Restart=always
RestartSec=5s
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
