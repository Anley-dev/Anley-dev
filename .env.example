# ============================================================
# Hawassa Call Center Navigation & Dispatch System
# Production Environment Configuration
# ============================================================

# Environment: production | staging | development
ENVIRONMENT=production

# Server Host and Port
HOST=0.0.0.0
PORT=8080
WORKERS=2

# Security & Secret Key (Generate a random 32-byte secret for production)
# Example: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string

# Initial Admin & Agent Credentials (created on first run if database is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_FULL_NAME=Supervisor Admin

AGENT_USERNAME=agent1
AGENT_PASSWORD=change-me-to-a-strong-agent-password
AGENT_FULL_NAME=Hawassa Agent 1

# Database Configuration
DB_PATH=hawassa_places.db

# Routing & AI Microservice Endpoints
VALHALLA_URL=http://localhost:8002
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:1.5b

# Rate Limiting (per IP)
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=120

# CORS Allowed Origins (Comma-separated or * for all)
CORS_ORIGINS=*

# Logging Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
